{
  "expo": {
    "name": "Solo1Meteo",
    "slug": "MeteoAggregator2",
    "version": "1.1.9",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.maxegon.meteostatapp",
      "buildNumber": "20",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Solo1Meteo usa la tua posizione, solo mentre l'app è aperta, per mostrarti le previsioni meteo della zona in cui ti trovi. La posizione non viene mai usata in background.",
        "NSPrivacyNutritionLabelTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePreciseLocation",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.maxegon.meteostatapp",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2cf51c05-7556-454b-ae6d-fc6090154682"
      }
    },
    "plugins": [
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "organization": "max-egon",
          "project": "react-native"
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "Solo1Meteo usa la tua posizione, solo mentre l'app è aperta, per mostrarti le previsioni meteo della zona in cui ti trovi. La posizione non viene mai usata in background.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/2cf51c05-7556-454b-ae6d-fc6090154682",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
