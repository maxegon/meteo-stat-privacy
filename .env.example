# Copia questo file in .env.local e compila i valori.
# Il file .env.local NON deve essere committato (è in .gitignore).
# Questo file .env.example DEVE essere committato come riferimento.
#
# Nota: in Expo le variabili pubbliche devono iniziare con EXPO_PUBLIC_
# per essere accessibili nel bundle dell'app.

# ─── AUTENTICAZIONE BACKEND ───────────────────────────────────────────────────

# Token condiviso con il backend per autenticare le richieste.
# Deve corrispondere a APP_SECRET_TOKEN nel backend .env / Vercel env vars.
# Generare con: openssl rand -hex 32
EXPO_PUBLIC_APP_SECRET_TOKEN=your_secret_here

# ─── CONTATTO ─────────────────────────────────────────────────────────────────

# Email di contatto usata nei User-Agent delle chiamate dirette a OpenStreetMap/Nominatim.
EXPO_PUBLIC_CONTACT_EMAIL=your@email.com
